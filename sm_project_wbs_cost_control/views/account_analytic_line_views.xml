<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_analytic_line_tree_wbs_cost" model="ir.ui.view">
        <field name="name">account.analytic.line.tree.wbs.cost</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='account_id']" position="after">
                <field name="sm_wbs_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_analytic_line_form_wbs_cost" model="ir.ui.view">
        <field name="name">account.analytic.line.form.wbs.cost</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='account_id']" position="after">
                <field name="sm_wbs_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_analytic_line_filter_wbs_cost" model="ir.ui.view">
        <field name="name">account.analytic.line.search.wbs.cost</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_line_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="sm_wbs_id"/>
                <filter string="WBS Item" name="group_sm_wbs_id" context="{'group_by': 'sm_wbs_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
