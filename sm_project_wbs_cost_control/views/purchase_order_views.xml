<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_wbs_cost" model="ir.ui.view">
        <field name="name">purchase.order.form.wbs.cost</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//field[@name='analytic_distribution']" position="after">
                <field name="sm_wbs_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
