        <field name="name">account.move.form.wbs.cost</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='analytic_distribution']" position="after">
                <field name="sm_wbs_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
